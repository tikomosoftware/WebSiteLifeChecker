# Vercel Cron Jobs の認証シークレット（任意のランダム文字列）
CRON_SECRET=your-secret-here

# 監視対象の設定（JSON配列）
# Supabase の monitor_targets テーブルが空の場合、またはSupabase未設定時に使用
# MONITOR_TARGETS=[{"name":"My Site","url":"https://example.com","timeout":10,"expectedStatus":200}]

# Supabase 設定
# 未設定の場合はインメモリで動作（ローカル開発用）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
